{
  "name": "webapp-monorepo-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:coverage:html": "c8 --include=calculator.js --exclude=**/*.test.js --reporter=text --reporter=html --reporter=lcov --reports-dir=coverage node --test",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "c8": "^10.1.3",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3"
  }
}
